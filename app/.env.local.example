# "ANTES" — o mesmo app apontando para um Postgres em container (profile local)
#   cp .env.local.example .env.local
#   APP_ENV_FILE=.env.local docker compose --profile local up --build
APP_AMBIENTE=postgres-local
LAKEBASE_AUTH_MODE=password
PGHOST=postgres-local
PGPORT=5432
PGDATABASE=energia
PGUSER=app_energia
PGPASSWORD=energia-local-123
PGSSLMODE=disable
