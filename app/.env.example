# =============================================================================
# app/.env — Passo 7:  cp app/.env.example app/.env   e preencha os 👉 ALTERE
# (o atalho opcional ./scripts/criar_service_principal.sh gera este arquivo)
# =============================================================================
APP_AMBIENTE=produção

# ---- Build (rede Databricks/VPN: pypi.org bloqueado) — fora da VPN, apague a linha
PIP_INDEX_URL=https://pypi-proxy.cloud.databricks.com/simple/

# ---- Lakebase ----------------------------------------------------------------
LAKEBASE_AUTH_MODE=oauth                 # oauth (Service Principal) | password (role nativa)
LAKEBASE_ENDPOINT=projects/energia-workshop/branches/production/endpoints/primary
PGHOST=ep-xxxx.database.<regiao>.azuredatabricks.net   # 👉 ALTERE (Compute › Lakebase › Connect)
PGPORT=5432
PGDATABASE=energia
PGSSLMODE=require

# ---- Modo oauth: OAuth M2M do Service Principal -------------------------------
DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net  # 👉 ALTERE
DATABRICKS_CLIENT_ID=<client-id-do-sp>       # 👉 ALTERE (Passo 6a)
DATABRICKS_CLIENT_SECRET=<secret-oauth-do-sp>  # 👉 ALTERE (Passo 6a)
DATABRICKS_AUTH_TYPE=oauth-m2m

# ---- Modo password (opcional, Passo 7.5): role Postgres nativa -------------------
PGUSER=app_energia
PGPASSWORD=<senha-definida-no-passo-6b>

# ---- Pool (opcional) -----------------------------------------------------------
# DB_POOL_MIN=1            # 0 = pool esvazia quando ocioso (permite scale-to-zero — Extra 2)
# DB_POOL_MAX=10
# DB_POOL_MAX_LIFETIME=2700   # recicla antes do token OAuth (1h) expirar
# DB_POOL_MAX_IDLE=300
